# Copy to /etc/archava/archava.env (systemd) or deploy/archava.env (compose),
# chmod 0600, and never commit it.
# The runtime role must be a NON-OWNER with the grants the migration profile
# creates. An owner/superuser URL is a startup refusal.
#
# Compose uses the service name `postgres`; a systemd deployment on the host
# should use 127.0.0.1 instead.
DATABASE_URL=postgres://archava_runtime:CHANGE_ME@postgres:5432/archava

# At least 32 bytes, hex encoded. Generate with:
#   openssl rand -hex 32
ARCHAVA_IDENTITY_KEY_HEX=CHANGE_ME_64_HEX_CHARS

ARCHAVA_BIND_ADDR=127.0.0.1:8347
ARCHAVA_SITE_ROOT=/opt/archava/site
RUST_LOG=info

# Ops encrypted backup/restore key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it off the backup volume; a ciphertext and its key in the same place is
# not encryption at rest.
ARCHAVA_BACKUP_KEY=

# Default false. Only set true for an intentional takeover after a crash or cutover.
# A normal shutdown or `archava-ops drain-writer` lets the next startup use false.
ARCHAVA_WRITER_TAKEOVER=false

# Optional administrator-managed payment registry; absent means unconfigured.
# JSON contains env variable names; provide actual server keys via service secrets.
# ARCHAVA_PAYMENT_CONFIG=/etc/archava/payment-providers.json

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://arc-leave-pst-suggestions.trycloudflare.com/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://arc-leave-pst-suggestions.trycloudflare.com/v1/:path*"
    },
    {
      "source": "/build",
      "destination": "/index.html"
    }
  ]
}

{
  "name": "archava-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Archava platform: solution configurator, deterministic pricing engine, tenant-scoped knowledge, and canonical chat interface.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "pnpm --fail-if-no-match --filter @archava/web... build",
    "build:web": "pnpm --fail-if-no-match --filter @archava/web build",
    "dev": "pnpm --fail-if-no-match --filter @archava/web dev",
    "start": "pnpm --fail-if-no-match --filter @archava/web start",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:web",
    "typecheck:web": "pnpm --fail-if-no-match --filter @archava/web exec tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "configurator": "tsx tools/configurator/src/cli.ts",
    "decision:eval": "tsx tools/decision-eval/run-rule.ts",
    "decision:jev-smoke": "tsx tools/decision-eval/live-jev.ts",
    "decision:jev-eval": "tsx tools/decision-eval/live-jev-eval.ts",
    "structure": "node tools/scripts/structure.mjs",
    "e2e:home": "node tools/e2e/home.mjs",
    "e2e:frontend": "node tools/e2e/frontend.mjs",
    "verify": "node tools/scripts/verify.mjs",
    "library:pack": "node tools/library/pack.mjs",
    "reuse:verify": "node tools/library/verify-consumers.mjs",
    "crm:verify": "pnpm --fail-if-no-match --filter @archava/crm-reference verify",
    "act:verify": "pnpm --fail-if-no-match --filter @archava/act-integration verify",
    "crm:gemini-eval": "pnpm --fail-if-no-match --filter @archava/crm-reference gemini:eval",
    "crm:dev": "pnpm --fail-if-no-match --filter @archava/crm-reference dev",
    "e2e:crm": "node tools/e2e/crm.mjs",
    "crm:build": "pnpm --fail-if-no-match --filter @archava/crm-host run build",
    "crm:setup": "pnpm --fail-if-no-match --filter @archava/crm-host run setup",
    "crm:start": "pnpm --fail-if-no-match --filter @archava/crm-host run start",
    "crm:user": "pnpm --fail-if-no-match --filter @archava/crm-host run user",
    "crm:backup": "pnpm --fail-if-no-match --filter @archava/crm-host run backup",
    "crm:backup-status": "pnpm --fail-if-no-match --filter @archava/crm-host run backup-status",
    "crm:backup-policy": "pnpm --fail-if-no-match --filter @archava/crm-host run backup-policy",
    "crm:backup-run": "pnpm --fail-if-no-match --filter @archava/crm-host run backup-run",
    "crm:restore": "pnpm --fail-if-no-match --filter @archava/crm-host run restore",
    "crm:ai-status": "pnpm --fail-if-no-match --filter @archava/crm-host run ai-status",
    "crm:resume-actions": "pnpm --fail-if-no-match --filter @archava/crm-host run resume-actions",
    "crm:doctor": "pnpm --fail-if-no-match --filter @archava/crm-host run doctor",
    "crm:verify-runtime": "pnpm --fail-if-no-match --filter @archava/crm-host run verify",
    "e2e:crm-runtime": "node tools/e2e/crm-runtime.mjs",
    "library:assemble": "node tools/library/assemble.mjs",
    "crm:modules": "pnpm --fail-if-no-match --filter @archava/crm-host run modules",
    "assembly:verify": "node tools/library/verify-assembly.mjs",
    "security:verify": "node tools/security/verify.mjs --run",
    "crm:benchmark": "pnpm --fail-if-no-match --filter @archava/crm-host run verify -- --benchmark",
    "crm:verify-upgrade": "node apps/crm/scripts/upgrade.mjs",
    "crm:verify-browser": "pnpm --fail-if-no-match --filter @archava/crm-host run verify -- --browser-once",
    "kits:plan": "node tools/library/plan-kits.mjs",
    "kits:verify": "node tools/library/verify-kits.mjs",
    "projects:verify": "node tools/library/verify-projects.mjs",
    "projects:verify-host": "node tools/library/verify-project-host.mjs",
    "scheduling:verify": "node tools/library/verify-scheduling.mjs",
    "scheduling:verify-host": "node tools/library/verify-scheduling-host.mjs",
    "accommodation:verify": "node tools/library/verify-accommodation.mjs",
    "accommodation:verify-host": "node tools/library/verify-accommodation-host.mjs",
    "commerce:verify": "node tools/library/verify-commerce.mjs",
    "commerce:verify-host": "node tools/library/verify-commerce-host.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "24.9.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "zod": "4.1.12",
    "esbuild": "0.25.12"
  }
}

  "limits": [
    "Bounded purchase quotes and physical receipts do not establish landed cost, freight, tax, payables or supplier invoices",
    "Initial receipt policy: cumulative accepted + rejected <= ordered; received means all ordered units have findings, not all accepted or paid",

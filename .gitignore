# dependencies
node_modules/

# build output
out/
dist/
.local/
build/

# rust build output — target/ must never be staged. Cargo.lock is
# deliberately NOT ignored: R01 pins the host stack (axum 0.8.9, sqlx 0.9.0,
# tokio 1.53.3) in the lockfile, and an unpinned workspace would resolve
# different versions on different machines.
target/
**/target/
*.wasm

# env
.env
.env.*
!.env.example
# deployment secrets (copy the .example files; never commit the filled ones)
deploy/archava.env
deploy/postgres.env

# secrets that must never reach a remote, even by accident
*.pem
*.key
credentials*
secrets*
service-account*

# tooling caches
coverage/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log

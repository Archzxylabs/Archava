# Copy to .env. Never put provider credentials in VITE_* variables.
# Optional public business CTA target, e.g. an official mailto: or wa.me link.
VITE_BUSINESS_CONTACT_URL=
PORT=5002
WEB_ORIGIN=http://localhost:5174
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore
# Fill the Spatius credentials below before starting the API and worker.
AVATAR_PROVIDER=spatius
ARCHAVA_AGENT_NAME=archava-host
SPATIUS_API_KEY=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=
TAVUS_API_KEY=
FACE_ID=
PAL_ID=
TAVUS_ENABLED=true

# BSC Testnet: ArchavaRentalV2 and ArchavaMockUSDT.
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
RENTAL_CONTRACT=0xefaacd259136d40cd26a8672697b591c1f84200c
PAYMENT_TOKEN_CONTRACT=0xd63574ac426169cda5495e1e196bf64d124267d0
RENTAL_DEPLOYMENT_BLOCK=134052025
# RPC_URL may be replaced with the private QuickNode BSC Testnet endpoint.

# Voice preview for development and demos. Paid access never uses this.
# The anonymous preview has no usage quota: a visitor may start another preview
# as soon as one ends, and two previews may overlap. Availability comes only from
# ENABLE_PREVIEW below.
# The former PREVIEW_TOTAL_LIMIT, PREVIEW_CONCURRENT_LIMIT, and
# PREVIEW_REPEAT_MINUTES knobs were removed. Deleting them from your .env is
# enough — any value left behind is ignored and cannot bring a cap back.
ENABLE_PREVIEW=false
PREVIEW_SECONDS=120

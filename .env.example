# ==============================================================================
# Archava Modular Monolith — Local Development Environment Template
#
# Copy this file to `.env` (never commit `.env`). Never put production secrets here.
# For persistent production or systemd deployments, see `deploy/archava.env.example`.
# ==============================================================================

# --- Database Connection (PostgreSQL) ----------------------------------------
# The runtime role must be a NON-OWNER with FORCE RLS enabled.
# The server refuses to start if run with owner, superuser, or BYPASSRLS roles.
DATABASE_URL=postgres://archava_runtime:archava_dev_password@127.0.0.1:5432/archava

# --- Server Binding & Logging ------------------------------------------------
ARCHAVA_BIND_ADDR=127.0.0.1:8347
RUST_LOG=info

# --- Identity & Session Encryption -------------------------------------------
# Cryptographic secret for signing session tokens and internal identity claims.
# Must contain at least 32 bytes (64 hex characters). Generate with:
#   openssl rand -hex 32
ARCHAVA_IDENTITY_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Encrypted Backup & Restore Key ------------------------------------------
# 32-byte base64 key for AES-256-GCM encryption of database dumps & tenant exports.
# Required by `archava-ops backup/restore`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ARCHAVA_BACKUP_KEY=

# --- Security Hardening & Gate Tokens ----------------------------------------
# Required for Prometheus /metrics endpoint when scraped from non-loopback IPs.
# ARCHAVA_METRICS_TOKEN=dev-metrics-token

# Comma-separated origins allowed to frame /embed/checkout (refuses wildcard '*').
# ARCHAVA_EMBED_FRAME_ANCESTORS=http://127.0.0.1:3000

# Writer lock takeover: set to true ONLY for manual emergency failover cutover.
ARCHAVA_WRITER_TAKEOVER=false

# Set only when a trusted local proxy supplies the original client address.
# Empty means forwarded client headers are ignored.
ARCHAVA_TRUSTED_PROXIES=

# --- Realtime Presence & WebRTC Audio (LiveKit) -------------------------------
# LiveKit rooms and Gemini Live together enable the native media bridge.
# If omitted, /presence/sessions returns 503 presence_unconfigured.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Realtime Model & AI Provider (Google Gemini) ----------------------------
# Choose a Live API model supported by your provider account. No model is guessed.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
# Optional separate key; falls back to GEMINI_API_KEY when omitted.
GEMINI_LIVE_API_KEY=

# --- Goal planner (text business planning, independent of Gemini Live) --------
# Choose a GenerateContent model enabled for your account; no model is guessed.
# Provider planning also requires a confirmed Owner selection in Settings > AI
# data sharing: areas, categories and company/workspace scope. Changed provider
# profiles require a new review; typed business actions remain local.
# Without a configured model, Ava provides bounded context/clarification,
# replenishment plans and explicit registered action forms.
# GEMINI_AGENT_MODEL=
# GEMINI_AGENT_API_KEY=
# Optional Gemini 3 text model profile: minimal, low, medium, high.
# Choose a level supported by that model; leave unset for provider defaults/2.5.
# GEMINI_AGENT_THINKING_LEVEL=
# Separate key optional; falls back to GEMINI_API_KEY.
# Endpoint defaults to https://generativelanguage.googleapis.com.
# GEMINI_AGENT_ENDPOINT is restricted to the Google endpoint or owned loopback
# fixtures. It must never contain credentials, query parameters or fragments.
